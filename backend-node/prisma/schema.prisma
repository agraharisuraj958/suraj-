// backend-node/prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  DOCTOR
  PATIENT
  RECEPTIONIST
}

model User {
  id            String         @id @default(uuid())
  email         String         @unique
  passwordHash  String
  role          Role
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  Patient       Patient?
  Doctor        Doctor?
  RefreshTokens RefreshToken[]
  ChatSessions  ChatSession[]
  AuditLogs     AuditLog[]
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Department {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  Doctors     Doctor[]
}

model Doctor {
  id             String               @id @default(uuid())
  userId         String               @unique
  user           User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  departmentId   String
  department     Department           @relation(fields: [departmentId], references: [id])
  Availabilities DoctorAvailability[]
  Appointments   Appointment[]
  Prescriptions  Prescription[]
}

model DoctorAvailability {
  id          String @id @default(uuid())
  doctorId    String
  doctor      Doctor @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  dayOfWeek   Int    // 0 = Sunday, 1 = Monday, etc.
  startTime   String // e.g., "09:00"
  endTime     String // e.g., "17:00"
  slotMinutes Int    @default(30)
}

model Patient {
  id                String         @id @default(uuid())
  userId            String         @unique
  user              User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  allergies         String[]
  chronicConditions String[]
  Appointments      Appointment[]
  Prescriptions     Prescription[]
  Documents         Document[]
}

enum AppointmentStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum TriageUrgency {
  LOW
  MEDIUM
  HIGH
}

model Appointment {
  id            String            @id @default(uuid())
  patientId     String
  patient       Patient           @relation(fields: [patientId], references: [id])
  doctorId      String
  doctor        Doctor            @relation(fields: [doctorId], references: [id])
  datetime      DateTime
  status        AppointmentStatus @default(SCHEDULED)
  triageUrgency TriageUrgency?
  triageSummary String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  Invoice       Invoice?
  Prescription  Prescription[]
}

model Prescription {
  id            String             @id @default(uuid())
  appointmentId String?            
  appointment   Appointment?       @relation(fields: [appointmentId], references: [id])
  patientId     String
  patient       Patient            @relation(fields: [patientId], references: [id])
  doctorId      String
  doctor        Doctor             @relation(fields: [doctorId], references: [id])
  notes         String?
  createdAt     DateTime           @default(now())
  Items         PrescriptionItem[]
}

model PrescriptionItem {
  id             String       @id @default(uuid())
  prescriptionId String
  prescription   Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  medication     String
  dosage         String
  frequency      String
  duration       String
}

enum InvoiceStatus {
  PENDING
  PAID
  CANCELLED
}

model Invoice {
  id            String        @id @default(uuid())
  appointmentId String        @unique
  appointment   Appointment   @relation(fields: [appointmentId], references: [id])
  amount        Float
  status        InvoiceStatus @default(PENDING)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

enum DocumentKind {
  GUIDELINE
  LAB_REPORT
  PATIENT_RECORD
}

enum DocumentStatus {
  UPLOADED
  PROCESSING
  INDEXED
  FAILED
}

model Document {
  id        String         @id @default(uuid())
  patientId String?        // Nullable because guidelines are global
  patient   Patient?       @relation(fields: [patientId], references: [id])
  kind      DocumentKind
  status    DocumentStatus @default(UPLOADED)
  url       String         // Path to local file storage
  title     String
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
}

model ChatSession {
  id        String        @id @default(uuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  createdAt DateTime      @default(now())
  Messages  ChatMessage[]
}

model ChatMessage {
  id        String      @id @default(uuid())
  sessionId String
  session   ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role      String      // "user" or "assistant"
  content   String
  citations Json?       // Stores AI retrieval citations
  createdAt DateTime    @default(now())
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  entity    String
  entityId  String?
  details   Json?
  createdAt DateTime @default(now())
}